;; metsuke is portable .cljc (ClojureScript-first, per repo-wide runtime
;; priority: kotoba wasm > clojurewasm > ClojureScript > nbb, JVM/bb
;; downgraded). This deps.edn is a compat shim ONLY, so a JVM `clojure`
;; invocation can lint/run the .cljc as plain Clojure if ever needed — the
;; canonical way to run this repo's tests is `nbb test/run_tests.cljk`
;; (see README.md), not `clojure -M:test`.
{:paths ["src" "test"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.11.1"}}}
